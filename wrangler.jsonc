{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baquelogue",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  // The app is static; only /api/* reaches the Worker script
  "assets": {
    "directory": "./app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "baquelogue", "migrations_dir": "worker/migrations" }],
  "routes": [{ "pattern": "baquelogue.com", "custom_domain": true }],
  // One origin only: local data lives in IndexedDB per origin
  "workers_dev": false,
  "preview_urls": false
}
